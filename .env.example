# Copy to .env.local for development. Never commit real values.

# Postgres connection. On Vercel: the Supabase transaction pooler URL (port 6543).
DATABASE_URL=postgres://postgres@localhost:54329/fnol_dev?host=/var/tmp

# Storage: "local" for development only; leave empty for Supabase Storage.
STORAGE_DRIVER=local
SUPABASE_URL=
# Secret key (sb_secret_...) for signed upload URLs. Server only.
SUPABASE_SECRET_KEY=

# Token signing keys: comma separated kid:base64 (at least 32 bytes each). Create one with:
#   openssl rand -base64 32
TOKEN_KEYS=k1:REPLACE_ME
TOKEN_ACTIVE_KID=k1

# Salt for hashing client addresses in the rate limiter.
RATE_LIMIT_SALT=REPLACE_ME

# Feature flags
DEMO_MODE=true
AUTH_MOCK_ENTRA=true
# Demo password for the mocked admin login (at least 12 characters). Sensitive.
ADMIN_DEMO_PASSWORD=
AI_ASSIST_ENABLED=false
# Only switch off for local automated tests; BotID only runs on Vercel.
BOT_CHECK=true
